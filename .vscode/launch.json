{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Run Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver"],
            "django": true,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DJANGO_SETTINGS_MODULE": "LifeLog.settings",
                "DB_HOST": "localhost",
                "DB_PORT": "5433"
            },
            "justMyCode": true
        },
        {
            "name": "Django: Run Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["test", "apps"],
            "django": true,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DJANGO_SETTINGS_MODULE": "LifeLog.settings",
                "DB_HOST": "localhost",
                "DB_PORT": "5433"
            },
            "justMyCode": true
        },
        {
            "name": "Django: Migrate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["migrate"],
            "django": true,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DJANGO_SETTINGS_MODULE": "LifeLog.settings",
                "DB_HOST": "localhost",
                "DB_PORT": "5433"
            },
            "justMyCode": true
        }
    ]
}
